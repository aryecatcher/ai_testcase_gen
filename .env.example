BACKEND_URL=http://localhost:8002

# Database
# SQLite default:
# DATABASE_URL=sqlite:///data/app_database.db
# PostgreSQL example:
# DATABASE_URL=postgresql+psycopg://user:password@host:5432/ai_testcase_gen
DATABASE_URL=sqlite:///data/app_database.db
GENERATION_QUEUE_WORKERS=1
GENERATION_RESUME_ON_STARTUP=false

# LLM
OPENAI_API_KEY=ollama
OPENAI_BASE_URL=http://localhost:11434/v1
LLM_MODEL_GEN=deepseek-r1:7b

# KG backend: auto | networkx | neo4j | hybrid
KG_BACKEND=auto
USE_SEMANTIC_MATCHER=false

# Neo4j
NEO4J_URI=bolt://localhost:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=change_me

