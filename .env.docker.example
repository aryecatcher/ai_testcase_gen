# Docker deployment example

APP_DATA_DIR=data
KG_STORAGE_PATH=data/kg_graph.json
KG_AUDIT_PATH=data/kg_audit.json
PROJECT_CONTEXT_JSON_PATH=data/project_context.json
TEMP_UPLOAD_DIR=temp_upload_api

POSTGRES_DB=ai_testcase_gen
POSTGRES_USER=ai_testcase_user
POSTGRES_PASSWORD=change_me

DATABASE_URL=postgresql+psycopg://ai_testcase_user:change_me@postgres:5432/ai_testcase_gen
GENERATION_QUEUE_WORKERS=1
GENERATION_RESUME_ON_STARTUP=false

OPENAI_API_KEY=ollama
OPENAI_BASE_URL=http://host.docker.internal:11434/v1
LLM_MODEL_GEN=deepseek-r1:7b
LEGACY_LLM_MODEL=deepseek-r1:7b
LEGACY_LLM_BASE_URL=http://host.docker.internal:11434/v1
LEGACY_LLM_API_KEY=ollama

KG_BACKEND=networkx
USE_SEMANTIC_MATCHER=false

NEO4J_URI=
NEO4J_USER=
NEO4J_PASSWORD=
